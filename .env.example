# ---------------------------------------------------------------------------
# Base de datos
# Opcion A — URL completa (toma precedencia si esta definida)
# Opcion B — variables individuales (usadas si DATABASE_URL esta vacia)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://sana:sana@localhost:5432/sana_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sana_db
DB_USER=sana
DB_PASSWORD=sana

# ---------------------------------------------------------------------------
# JWT
# Para generar JWT_SECRET_KEY: openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change_me_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_RESET_TOKEN_EXPIRE_MINUTES=15

# ---------------------------------------------------------------------------
# Cookie
# COOKIE_MAX_AGE debe coincidir con JWT_ACCESS_TOKEN_EXPIRE_MINUTES * 60
# ---------------------------------------------------------------------------
COOKIE_NAME=sana_session
COOKIE_REFRESH_NAME=sana_refresh
COOKIE_MAX_AGE=3600

# ---------------------------------------------------------------------------
# Ambiente
# Valores posibles: development | testing | production
# ---------------------------------------------------------------------------
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Logging
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT: pretty (desarrollo) | json (produccion)
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=pretty

# ---------------------------------------------------------------------------
# CORS
# Development: *
# Production: lista separada por comas, ej. https://app.sana.io
# ---------------------------------------------------------------------------
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Resend — servicio de envio de emails
# API key en: https://resend.com/api-keys
# Template IDs: correr scripts/create_resend_templates.py para generarlos
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_change_me
RESEND_FROM_EMAIL=noreply@mg.airlytics.tech
RESEND_TEMPLATE_RESET_PASSWORD=change_me
RESEND_TEMPLATE_ACCOUNT_CREATED=change_me
RESEND_TEMPLATE_ALERT_EVENT=change_me
RESEND_TEMPLATE_COLLABORATOR_ADDED=change_me

# ---------------------------------------------------------------------------
# Frontend
# URL base para construir el link de reset de contrasena
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_TITLE=SANA Airlytics API
API_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Sentry (opcional — dejar vacio para deshabilitar)
# ---------------------------------------------------------------------------
SENTRY_DSN=

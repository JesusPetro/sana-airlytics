{
  "title": "k6 Load Testing",
  "uid": "k6-benchmark",
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Virtual Users",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "k6_vus",
          "legendFormat": "VUs activos"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } }
      }
    },
    {
      "id": 2,
      "title": "Requests por segundo",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(k6_http_reqs_total[30s])",
          "legendFormat": "RPS"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } }
      }
    },
    {
      "id": 3,
      "title": "Tasa de errores",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "k6_http_req_failed_rate * 100",
          "legendFormat": "% errores"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Latencia (ms)",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "k6_http_req_duration_p50 * 1000",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "k6_http_req_duration_p90 * 1000",
          "legendFormat": "p90"
        },
        {
          "datasource": "Prometheus",
          "expr": "k6_http_req_duration_p95 * 1000",
          "legendFormat": "p95"
        },
        {
          "datasource": "Prometheus",
          "expr": "k6_http_req_duration_p99 * 1000",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "id": 5,
      "title": "Latencia p95 / p99",
      "type": "stat",
      "gridPos": { "x": 0, "y": 6, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "k6_http_req_duration_p95 * 1000",
          "legendFormat": "p95"
        },
        {
          "datasource": "Prometheus",
          "expr": "k6_http_req_duration_p99 * 1000",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "options": { "colorMode": "background" }
    },
    {
      "id": 6,
      "title": "Checks exitosos",
      "type": "stat",
      "gridPos": { "x": 6, "y": 6, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "k6_checks_rate * 100",
          "legendFormat": "% success"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": { "colorMode": "background" }
    },
    {
      "id": 7,
      "title": "Latencia promedio (ms)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 6, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "(k6_http_req_duration_p50 + k6_http_req_duration_p90) / 2 * 1000",
          "legendFormat": "avg aprox"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 300 }
            ]
          }
        }
      },
      "options": { "colorMode": "background" }
    },
    {
      "id": 8,
      "title": "Total requests",
      "type": "stat",
      "gridPos": { "x": 18, "y": 6, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "k6_http_reqs_total",
          "legendFormat": "requests"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } }
      },
      "options": { "colorMode": "background" }
    },
    {
      "id": 9,
      "title": "Breakdown de latencia",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 7 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "k6_http_req_waiting_p95 * 1000",
          "legendFormat": "waiting (TTFB)"
        },
        {
          "datasource": "Prometheus",
          "expr": "k6_http_req_sending_p95 * 1000",
          "legendFormat": "sending"
        },
        {
          "datasource": "Prometheus",
          "expr": "k6_http_req_receiving_p95 * 1000",
          "legendFormat": "receiving"
        },
        {
          "datasource": "Prometheus",
          "expr": "k6_http_req_connecting_p95 * 1000",
          "legendFormat": "connecting"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 10,
      "title": "Datos transferidos",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 7 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(k6_data_received_total[30s])",
          "legendFormat": "recibido"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(k6_data_sent_total[30s])",
          "legendFormat": "enviado"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    }
  ],
  "schemaVersion": 38
}
